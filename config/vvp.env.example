# Copy this file to .env. Never commit credentials in .env.
export VVP_API_BASE_URL="https://vvp-api.example.internal"
export VVP_API_NAMESPACE="project-namespace"
export VVP_API_PREFIX="/api/v1"
export VVP_DEPLOYMENT_TARGET_NAME="project-target"
export S3_ARTIFACT_URI_PREFIX="s3://project-flink-artifacts"
export S3_CHECKPOINT_URI_PREFIX="s3://project-flink-checkpoints"
export S3_SAVEPOINT_URI_PREFIX="s3://project-flink-savepoints"

# Configure the S3-compatible endpoint, region and credentials in the VVP
# deployment target or platform-managed Flink configuration, not in this file.

# Optional pass-through. Inject the generated token through the shell or CI;
# leave it empty for API access without authentication. Do not hard-code it.
export VVP_API_TOKEN="${VVP_API_TOKEN:-}"

export VVP_INSECURE_TLS="false"
export VVP_REQUEST_TIMEOUT="60"
export VVP_POLL_SECONDS="10"
export VVP_WAIT_TIMEOUT_SECONDS="600"
export VVP_WAIT="true"
