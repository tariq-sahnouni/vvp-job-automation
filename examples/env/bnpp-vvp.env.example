# Copy to .env at the vvp-marketplace root and fill in the installed VVP values.
export VVP_API_BASE_URL="https://vvp-api.example.internal"
export VVP_API_NAMESPACE="replace-with-vvp-api-namespace"
export VVP_DEPLOYMENT_TARGET_NAME="replace-with-project-target"
export S3_ARTIFACT_URI_PREFIX="s3://replace-with-artifact-bucket"
export S3_CHECKPOINT_URI_PREFIX="s3://replace-with-checkpoint-bucket"
export S3_SAVEPOINT_URI_PREFIX="s3://replace-with-savepoint-bucket"
# Inject the generated token when required; do not hard-code it here.
export VVP_API_TOKEN="${VVP_API_TOKEN:-}"
export VVP_REQUEST_TIMEOUT="60"
export VVP_WAIT="true"
