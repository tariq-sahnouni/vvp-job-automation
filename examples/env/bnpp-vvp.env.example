# Copy to .env at the vvp-marketplace root and fill in the installed VVP values.
export VVP_API_BASE_URL="https://vvp-api.example.internal"
export VVP_API_NAMESPACE="replace-with-vvp-api-namespace"
export VVP_AUTH_PROVIDER="keycloak"
export KEYCLOAK_TOKEN_URL="https://sso.example.internal/realms/replace-me/protocol/openid-connect/token"
export KEYCLOAK_CLIENT_ID="replace-me"
# Supply KEYCLOAK_CLIENT_SECRET through your secret manager or shell environment.
export VVP_REQUEST_TIMEOUT="60"
export VVP_WAIT="true"
