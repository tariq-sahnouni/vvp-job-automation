# VVP session deployment: deploy a job onto an existing VVP session cluster.
export VVP_API_BASE_URL="${VVP_API_BASE_URL:-https://vvp.example.com}"
export VVP_API_NAMESPACE="${VVP_API_NAMESPACE:-team-payments}"
export VVP_WAIT="${VVP_WAIT:-true}"
export VVP_EXPECTED_STATE="${VVP_EXPECTED_STATE:-RUNNING}"
export VVP_CONFIRM_DELETE="${VVP_CONFIRM_DELETE:-false}"
