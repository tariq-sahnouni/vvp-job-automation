# Keycloak client-credentials AuthN.
export FLINK_AUTH_PROVIDER="${FLINK_AUTH_PROVIDER:-keycloak}"
export VVP_AUTH_PROVIDER="${VVP_AUTH_PROVIDER:-keycloak}"
export KEYCLOAK_BASE_URL="${KEYCLOAK_BASE_URL:-https://sso.example.com}"
export KEYCLOAK_REALM="${KEYCLOAK_REALM:-platform}"
export KEYCLOAK_CLIENT_ID="${KEYCLOAK_CLIENT_ID:-flink-deployer}"
export KEYCLOAK_CLIENT_SECRET="${KEYCLOAK_CLIENT_SECRET:-replace-me}"
# export KEYCLOAK_SCOPE=openid
# export KEYCLOAK_TOKEN_URL=https://sso.example.com/realms/platform/protocol/openid-connect/token
