# Shared defaults used by all scripts.
export FLINK_REQUEST_TIMEOUT="${FLINK_REQUEST_TIMEOUT:-60}"
export FLINK_POLL_SECONDS="${FLINK_POLL_SECONDS:-10}"
export FLINK_WAIT_TIMEOUT_SECONDS="${FLINK_WAIT_TIMEOUT_SECONDS:-600}"
export FLINK_WAIT="${FLINK_WAIT:-false}"
export FLINK_DRY_RUN="${FLINK_DRY_RUN:-false}"
export FLINK_INSECURE_TLS="${FLINK_INSECURE_TLS:-false}"
export VVP_REQUEST_TIMEOUT="${VVP_REQUEST_TIMEOUT:-$FLINK_REQUEST_TIMEOUT}"
export VVP_POLL_SECONDS="${VVP_POLL_SECONDS:-$FLINK_POLL_SECONDS}"
export VVP_WAIT_TIMEOUT_SECONDS="${VVP_WAIT_TIMEOUT_SECONDS:-$FLINK_WAIT_TIMEOUT_SECONDS}"
export VVP_WAIT="${VVP_WAIT:-$FLINK_WAIT}"
export VVP_DRY_RUN="${VVP_DRY_RUN:-$FLINK_DRY_RUN}"
export VVP_INSECURE_TLS="${VVP_INSECURE_TLS:-$FLINK_INSECURE_TLS}"
